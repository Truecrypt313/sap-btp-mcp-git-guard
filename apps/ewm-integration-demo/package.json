{
  "name": "ewm-integration-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only CAP OData V4 demo for simulated EWM goods receipts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "cds watch",
    "serve": "cds serve",
    "test": "node --test"
  },
  "dependencies": {
    "@cap-js/sqlite": "3.1.3",
    "@sap/cds": "10.2.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "10.2.1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": ":memory:"
        }
      }
    }
  }
}
